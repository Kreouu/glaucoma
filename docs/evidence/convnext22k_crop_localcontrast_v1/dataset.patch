+class LocalContrast:
+    def __init__(self, strength):
+        self.strength = strength
+    def __call__(self, image):
+        if self.strength == 0:
+            return image
+        original = np.asarray(image).astype(np.float32)
+        background = np.asarray(image.filter(ImageFilter.GaussianBlur(min(image.size) / 30))).astype(np.float32)
+        corrected = np.clip(original - self.strength * background + 128 * self.strength, 0, 255).astype(np.uint8)
+        corrected[original.max(axis=2) < 8] = 0
+        return Image.fromarray(corrected)
 
 
